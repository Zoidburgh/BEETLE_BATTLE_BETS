+def _volley_factor(attacker, victim, jv, ref):
+    """J1 SOFT JUGGLE (soft_juggle_plan.md, calibrated by the J0 trace):
+    lift delivered to an AIRBORNE victim scales with the relative
+    vertical closing speed at the contact — a falling victim met by a
+    rising horn takes a full-strength volley; a static horn parked under
+    a hovering victim transfers little (no relative motion = no impulse
+    — which also naturally defangs the mid-air press-down, whose closing
+    is ~zero). J0 numbers: falls arrive at 5-11, an active horn adds
+    ~2 rad/s x ~8 voxel lever = ~16 tip speed; ref 14 = a timed flick on
+    a real fall saturates, a static catch of a fast fall lands partial.
+    jv (JUGGLE_VOLLEY) blends: 0 = off (old constant force), 1 = fully
+    closing-gated. Grounded victims always 1.0 (ground battles sacred)."""
+    if jv <= 0.0 or victim.air_gap <= 1.5:
+        return 1.0
+    tip_up = attacker.horn_pitch_velocity * 8.0 + max(attacker.vy, 0.0)
+    # RISING-VICTIM RULE (2026-07-19): only their DOWNWARD motion counts
+    # against the closing. A rising victim used to subtract their upward
+    # speed, zeroing the volley for lifts under an already-popped beetle
+    # ("clearly lift under an already lifted beetle, no boost") — but a
+    # horn planted under a riser is sustained contact, not a missed hit;
+    # the flick reads its full tip speed
+    closing = tip_up - min(victim.vy, 0.0)  # victim falling => positive
+    v = max(0.0, min(1.0, closing / max(ref, 0.05)))
+    return (1.0 - jv) + jv * v
